<Window x:Class="MdViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="MdViewer"
        Height="760"
        Width="1280"
        MinHeight="420"
        MinWidth="760"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <DockPanel>
        <!-- Single modern top bar (GitHub-like) -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushKey}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="MdViewer"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppForegroundBrush}"/>
                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrushKey}" Margin="14,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Content="New" Click="NewFile_Click" ToolTip="New (Ctrl+N)"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Content="Open" Click="OpenFile_Click" ToolTip="Open file (Ctrl+O)"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Content="Folder" Click="OpenFolder_Click" ToolTip="Open folder / workspace (Ctrl+Shift+O)"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Content="Save" Click="SaveFile_Click" ToolTip="Save (Ctrl+S)"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Content="Find" Click="Find_Click" ToolTip="Find (Ctrl+F)"/>
                    <Button x:Name="MoreButton"
                            Style="{StaticResource ToolbarIconButton}"
                            Content="More ▾"
                            Click="MoreButton_Click"
                            ToolTip="More actions"/>
                </StackPanel>

                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SegmentTrackBrush}"
                        CornerRadius="8"
                        Padding="3"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ToolbarEditorButton" Style="{StaticResource SegmentButton}" Content="Editor" Click="ViewEditor_Click" ToolTip="Editor only"/>
                        <ToggleButton x:Name="ToolbarSplitButton" Style="{StaticResource SegmentButton}" Content="Split" IsChecked="True" Click="ViewSplit_Click" ToolTip="Split view"/>
                        <ToggleButton x:Name="ToolbarViewerButton" Style="{StaticResource SegmentButton}" Content="Preview" Click="ViewViewer_Click" ToolTip="Preview only"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="ToolbarFocusButton"
                                  Style="{StaticResource IconToggleButton}"
                                  Content="Focus"
                                  Click="ToggleFocusMode_Click"
                                  ToolTip="Focus mode — dim other paragraphs"/>
                    <ToggleButton x:Name="ToolbarSidebarButton"
                                  Style="{StaticResource IconToggleButton}"
                                  Content="Files"
                                  IsChecked="True"
                                  Click="ToggleSidebar_Click"
                                  ToolTip="Toggle sidebar"/>
                    <ToggleButton x:Name="ToolbarDarkButton"
                                  Style="{StaticResource IconToggleButton}"
                                  Content="Dark"
                                  Click="ToggleDarkTheme_Click"
                                  ToolTip="Toggle appearance"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Document tabs -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushKey}"
                BorderThickness="0,0,0,1"
                Padding="8,0,8,0"
                MinHeight="36">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabChrome"
                                    Style="{StaticResource DocTabChromeStyle}"
                                    Tag="{Binding}"
                                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Tab_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="Tab_PreviewMouseLeftButtonUp"
                                    MouseRightButtonUp="Tab_MouseRightButtonUp"
                                    ToolTip="{Binding FilePath}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource DocTabCloseButton}"
                                            Content="×"
                                            Click="TabClose_Click"
                                            Tag="{Binding}"
                                            ToolTip="Close"/>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="180"
                                               Margin="2,0,6,0"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushKey}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="StatusModeText"
                           DockPanel.Dock="Right"
                           Text="Split"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="16,0,0,0"/>
                <TextBlock x:Name="StatusStatsText"
                           DockPanel.Dock="Right"
                           Text=""
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="16,0,0,0"/>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="160"/>
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    x:Name="SidebarPanel"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    Margin="10,10,0,10"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrushKey}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12,14,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="WORKSPACE" Style="{StaticResource PanelCaption}" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource ToolbarIconButton}"
                                            Content="Change"
                                            Padding="8,3"
                                            Margin="0"
                                            FontSize="11"
                                            Click="OpenFolder_Click"
                                            ToolTip="Open a different folder as workspace"/>
                                    <Button x:Name="CloseWorkspaceButton"
                                            Style="{StaticResource ToolbarIconButton}"
                                            Content="Close"
                                            Padding="8,3"
                                            Margin="2,0,0,0"
                                            FontSize="11"
                                            Click="CloseWorkspace_Click"
                                            ToolTip="Close workspace"
                                            Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="SidebarTitle"
                                       Text="No folder open"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AppForegroundBrush}"
                                       ToolTip="No folder open"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SidebarEmptyText"
                               Margin="14,8,14,14"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Text="No workspace open. Use Change to browse for a folder, or Folder in the toolbar (Ctrl+Shift+O)."/>
                    <TreeView x:Name="FileTree"
                              Visibility="Collapsed"
                              SelectedItemChanged="FileTree_SelectedItemChanged"
                              MouseDoubleClick="FileTree_MouseDoubleClick"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" x:Name="SidebarSplitter" Style="{StaticResource ModernSplitter}"/>

            <Grid Grid.Column="2" x:Name="ContentGrid" Margin="0,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="200"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="Auto"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        x:Name="EditorPanel"
                        Background="{DynamicResource EditorBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                BorderBrush="{DynamicResource BorderBrushKey}"
                                BorderThickness="0,0,0,1"
                                Background="{DynamicResource PanelBackgroundBrush}">
                            <TextBlock Text="SOURCE" Style="{StaticResource PanelCaption}"/>
                        </Border>

                        <!-- Find / Replace bar (GitHub-style) -->
                        <Border x:Name="FindReplaceBar"
                                DockPanel.Dock="Top"
                                Visibility="Collapsed"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushKey}"
                                BorderThickness="0,0,0,1"
                                Padding="10,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FindTextBox"
                                             Style="{StaticResource FindTextBox}"
                                             VerticalContentAlignment="Center"
                                             TextChanged="FindTextBox_TextChanged"
                                             KeyDown="FindTextBox_KeyDown"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="FindCountText"
                                                   Text=""
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   FontSize="12"/>
                                        <Button Style="{StaticResource ToolbarIconButton}" Content="↑" Click="FindPrevious_Click" ToolTip="Previous (Shift+Enter)"/>
                                        <Button Style="{StaticResource ToolbarIconButton}" Content="↓" Click="FindNext_Click" ToolTip="Next (Enter)"/>
                                        <ToggleButton x:Name="MatchCaseToggle"
                                                      Style="{StaticResource IconToggleButton}"
                                                      Content="Aa"
                                                      ToolTip="Match case"
                                                      Click="FindOptions_Changed"/>
                                        <ToggleButton x:Name="RegexToggle"
                                                      Style="{StaticResource IconToggleButton}"
                                                      Content=".*"
                                                      ToolTip="Use regular expression"
                                                      Click="FindOptions_Changed"/>
                                        <Button Style="{StaticResource ToolbarIconButton}" Content="✕" Click="CloseFind_Click" ToolTip="Close (Esc)"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ReplaceTextBox"
                                             Style="{StaticResource FindTextBox}"
                                             VerticalContentAlignment="Center"
                                             KeyDown="ReplaceTextBox_KeyDown"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Style="{StaticResource ToolbarIconButton}" Content="Replace" Click="Replace_Click" ToolTip="Replace current"/>
                                        <Button Style="{StaticResource ToolbarPrimaryButton}" Content="Replace all" Click="ReplaceAll_Click" ToolTip="Replace all matches"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <avalonEdit:TextEditor x:Name="Editor"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="14"
                                               ShowLineNumbers="True"
                                               WordWrap="True"
                                               Padding="4"
                                               AllowDrop="True"
                                               PreviewDragOver="Editor_PreviewDragOver"
                                               Drop="Editor_Drop"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto"
                                               Background="{DynamicResource EditorBackgroundBrush}"
                                               Foreground="{DynamicResource EditorForegroundBrush}"
                                               LineNumbersForeground="{DynamicResource MutedForegroundBrush}"
                                               TextChanged="Editor_TextChanged"/>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" x:Name="ViewSplitter" Style="{StaticResource ModernSplitter}"/>

                <Border Grid.Column="2"
                        x:Name="PreviewPanel"
                        Background="{DynamicResource EditorBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                BorderBrush="{DynamicResource BorderBrushKey}"
                                BorderThickness="0,0,0,1"
                                Background="{DynamicResource PanelBackgroundBrush}">
                            <TextBlock Text="PREVIEW" Style="{StaticResource PanelCaption}"/>
                        </Border>
                        <wv2:WebView2 x:Name="PreviewWebView" DefaultBackgroundColor="#FAF8FC"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
